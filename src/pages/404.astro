---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden" noindex>
  <section class="not-found">
    <div class="container">
      <p class="eyebrow aurora-text">404</p>
      <h1 class="headline">Diese Seite hat sich wegautomatisiert.</h1>
      <p class="lead">Vielleicht wurde sie verschoben oder umbenannt.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/">Zur Startseite</a>
        <a class="link-more" href="/guides/">Guides durchsuchen</a>
      </div>
    </div>
  </section>
</Base>
